# Copie para .env (ou exporte no ambiente). Nenhum segredo é necessário.

# Porta e interface do servidor HTTP/WebSocket
PORT=3210
HOST=0.0.0.0

# Banco SQLite (criado e migrado automaticamente)
DATABASE_PATH=./data/martelo.db

# Baralho de cartas (formato em docs/BARALHO.md). Sem esta linha o servidor usa
# data/deck-wikidata.json (jogadores reais: Séries A e B + grandes da Europa).
# Só descomente para forçar outro baralho (ex.: o fictício, ./data/deck.json).
# DECK_PATH=./data/deck-wikidata.json

# Pasta do cliente compilado (npm run build)
STATIC_DIR=./dist

# Força o ritmo de todas as salas: normal | turbo | test | e2e (vazio = cada sala escolhe)
GAME_SPEED=

# Sessões expiram após N dias sem uso
SESSION_TTL_DAYS=60

# Disputa sem ninguém conectado é encerrada após N minutos
ABANDON_AFTER_MIN=30

# Sala no lobby sem ninguém conectado é fechada após N minutos
IDLE_ROOM_CLOSE_MIN=120

# debug | info | warn | error
LOG_LEVEL=info
